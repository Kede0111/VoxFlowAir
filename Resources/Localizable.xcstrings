            "value": "Apparence"
          }
        }
      }
    },
    "Applied each time the preset loads. Apps find the microphone by its identifier: renaming it does not change their setting.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqué à chaque chargement du preset. Les applications retrouvent le micro par son identifiant : le renommer ne change pas leur réglage."
          }
        }
      }
    },
    "Apply": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer"
          }
        }
      }
    },
    "Arrange nodes in chain order (positions only, the sound doesn't change; ⌘Z to undo)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranger les nœuds dans l'ordre de la chaîne (positions seulement, le son ne change pas ; ⌘Z pour annuler)"
          }
        }
      }
    },
