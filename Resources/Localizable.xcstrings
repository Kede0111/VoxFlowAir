            "value": "« %@ » restauré dans sa version d'origine."
          }
        }
      }
    },
    "“%@” was unreadable and has been restored from its backup copy.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » illisible, restauré depuis sa copie de sécurité."
