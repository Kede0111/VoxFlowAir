    "Active. In FaceTime (Video › Output), choose “%@”: you hear the call and your processed voice in the headphones, without FaceTime cancelling it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Actif. Dans FaceTime (Vidéo › Sortie), choisissez « %@ » : vous entendez l'appel et votre voix traitée dans le casque, sans que FaceTime ne l'efface."
          }
        }
      }
    },
