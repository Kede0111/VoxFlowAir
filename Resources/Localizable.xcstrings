    "": {
      "shouldTranslate": false
    },
    "%@ %lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$lld"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ (%lld ch)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ (%2$lld ch)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ (%2$lld can.)"
          }
        }
      }
    },
    "%@ (VoxFlowAir driver)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (pilote VoxFlowAir)"
          }
        }
      }
    },
    "%@ copy": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ copie"
          }
        }
      }
    },
    "%@ is listening to BlackHole: its echo canceller erases the voice going through BlackHole, so the other party may not hear you. Use the VoxFlowAir microphone: Settings › Virtual Output “VoxFlowAir Micro (VoxFlowAir driver)”, then choose that microphone in the call.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ écoute BlackHole : son annulateur d'écho efface la voix qui passe par BlackHole, votre correspondant risque de ne pas vous entendre. Utilisez le micro VoxFlowAir : Réglages › Sortie virtuelle « VoxFlowAir Micro (pilote VoxFlowAir) », puis choisissez ce micro dans l'appel."
          }
        }
      }
    },
    "%@ ms (not measured)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ms (non mesurée)"
          }
        }
      }
    },
